{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blacktape",
  "version": "0.4.0",
  "identifier": "dev.seafood.blacktape",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:blacktape.db"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/seafoodd/blacktape-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBRUQ0NTc2MTJDRjg2MUUKUldRZWhzOFNka1h0NnAwOC9VdUhnZXZvdFo2ZUZGRUFSejBCSTJCT09BOXZnUmRZcnVVWGxoVFEK"
    }	
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blacktape",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 320,
        "transparent": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost thumb: http://thumb.localhost https://thumb.localhost https://*.bcbits.com https: data:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$HOME/blacktape-lib/**"]
      }
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 26
    },
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
